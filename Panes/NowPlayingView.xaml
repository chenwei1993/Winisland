<UserControl x:Class="WinIsland.Panes.NowPlayingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="448">
    <Grid>
        <!-- Now playing -->
        <StackPanel VerticalAlignment="Center"
                    Visibility="{Binding HasMedia, Converter={StaticResource BoolToVis}}">
            <Border Width="168" Height="168" CornerRadius="22" Background="{StaticResource IconTileBrush}"
                    HorizontalAlignment="Center">
                <Grid>
                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="46"
                               Foreground="{StaticResource TextPrimaryBrush}" Opacity="0.22"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Border CornerRadius="22">
                        <Border.Clip>
                            <RectangleGeometry Rect="0,0,168,168" RadiusX="22" RadiusY="22" />
                        </Border.Clip>
                        <Image Source="{Binding MediaArt}" Stretch="UniformToFill" />
                    </Border>
                </Grid>
            </Border>

            <TextBlock Text="{Binding MediaSource}" FontSize="9.5" Foreground="{StaticResource TextTertiaryBrush}"
                       HorizontalAlignment="Center" Margin="0,12,0,0" />

            <TextBlock Text="{Binding MediaTitle}" FontSize="17" FontWeight="SemiBold"
                       FontFamily="{StaticResource DisplayFont}" HorizontalAlignment="Center"
                       TextTrimming="CharacterEllipsis" MaxWidth="380" Margin="0,3,0,0" />

            <TextBlock Text="{Binding MediaArtist}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="380"
                       Margin="0,2,0,0" />

            <Grid Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Height="20">
                    <Slider x:Name="SeekBar" Style="{StaticResource SeekSlider}"
                            Minimum="0" Maximum="{Binding MediaDuration}"
                            Value="{Binding MediaPosition, Mode=OneWay}"
                            IsEnabled="{Binding CanSeek}" IsHitTestVisible="False" />
                    <Border x:Name="SeekHit" Background="Transparent" Cursor="Hand"
                            IsHitTestVisible="{Binding CanSeek}"
                            PreviewMouseLeftButtonDown="Seek_Down"
                            PreviewMouseMove="Seek_Move"
                            PreviewMouseLeftButtonUp="Seek_Up"
                            LostMouseCapture="Seek_Lost" />
                </Grid>
                <Grid Grid.Row="1" Margin="1,1,1,0">
                    <TextBlock Text="{Binding PositionText}" FontSize="9.5"
                               Foreground="{StaticResource TextTertiaryBrush}" />
                    <TextBlock Text="{Binding DurationText}" FontSize="9.5"
                               Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Right" />
                </Grid>
                <TextBlock x:Name="SeekHint" Grid.Row="2" Text="当前播放器不支持进度跳转"
                           FontSize="9.5" Foreground="{StaticResource OrangeBrush}"
                           HorizontalAlignment="Center" Margin="0,3,0,0" Visibility="Collapsed" />
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                <Button Style="{StaticResource IconButton}" Content="&#xE892;" FontSize="16"
                        Width="40" Height="40" Click="Previous_Click" ToolTip="上一首" />
                <Button Style="{StaticResource PlayButton}" Content="{Binding PlayPauseGlyph}"
                        Margin="14,0" Click="PlayPause_Click" ToolTip="播放 / 暂停" />
                <Button Style="{StaticResource IconButton}" Content="&#xE893;" FontSize="16"
                        Width="40" Height="40" Click="Next_Click" ToolTip="下一首" />
            </StackPanel>

            <Grid Margin="2,10,2,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource IconButton}" FontSize="13" Width="28" Height="28"
                        Content="{Binding MuteGlyph}" Click="Mute_Click" ToolTip="静音" />
                <Slider Grid.Column="1" Style="{StaticResource VolumeSlider}" Margin="4,0"
                        Minimum="0" Maximum="100" Value="{Binding VolumePercent, Mode=OneWay}"
                        ValueChanged="Volume_ValueChanged" />
                <TextBlock Grid.Column="2" Text="{Binding VolumePercent, StringFormat={}{0:0}%}"
                           FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Width="34" TextAlignment="Right" />
            </Grid>
        </StackPanel>

        <!-- Empty state -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding HasMedia, Converter={StaticResource InverseBoolToVis}}">
            <Border Width="80" Height="80" CornerRadius="24" Background="{StaticResource IconTileBrush}"
                    HorizontalAlignment="Center">
                <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="30"
                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="暂无正在播放" FontSize="15" FontWeight="SemiBold"
                       FontFamily="{StaticResource DisplayFont}" HorizontalAlignment="Center" Margin="0,16,0,4" />
            <TextBlock Text="在任意播放器中播放音乐，即可上岛" FontSize="11"
                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
            <Button Content="重新检测" Style="{StaticResource GhostButton}" Margin="0,16,0,0"
                    HorizontalAlignment="Center" Click="Refresh_Click" />
        </StackPanel>
    </Grid>
</UserControl>
