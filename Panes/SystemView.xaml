<UserControl x:Class="WinIsland.Panes.SystemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ctrl="clr-namespace:WinIsland.Controls"
             mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="448">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,4,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- CPU -->
                <Border Style="{StaticResource Card}" Margin="0,0,5,5" Padding="13,11">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="处理器" Style="{StaticResource Caption}" />
                            <TextBlock Text="实时" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="{Binding CpuPercent, StringFormat={}{0:0}%}" FontSize="25"
                                   FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}" Margin="0,3,0,0" />
                        <ctrl:Sparkline Height="34" Margin="0,3,0,0" Values="{Binding CpuSamples}"
                                        Stroke="{StaticResource AccentBrush}" Fill="#146C8CFF" Maximum="100" />
                    </StackPanel>
                </Border>

                <!-- Memory -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="5,0,0,5" Padding="13,11">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="内存" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding RamUsedText}" Style="{StaticResource Caption}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="{Binding RamPercent, StringFormat={}{0:0}%}" FontSize="25"
                                   FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}" Margin="0,3,0,0" />
                        <ctrl:Sparkline Height="34" Margin="0,3,0,0" Values="{Binding RamSamples}"
                                        Stroke="{StaticResource PurpleBrush}" Fill="#12B06CFF" Maximum="100" />
                    </StackPanel>
                </Border>

                <!-- Network -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,5,5,0" Padding="13,11">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="网络" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding AdapterText}" Style="{StaticResource Caption}"
                                       HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="92" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="↓" FontSize="13" Foreground="{StaticResource AccentBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding NetDownText}" FontSize="15" FontWeight="SemiBold" Margin="3,0,0,0" />
                            <TextBlock Text="↑" FontSize="12" Foreground="{StaticResource GreenBrush}"
                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                            <TextBlock Text="{Binding NetUpText}" FontSize="10.5"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                                       Margin="3,0,0,0" />
                        </StackPanel>
                        <ctrl:Sparkline Height="30" Margin="0,4,0,0" Values="{Binding NetSamples}"
                                        Stroke="{StaticResource GreenBrush}" Fill="#1430D158" />
                    </StackPanel>
                </Border>

                <!-- Battery -->
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Margin="5,5,0,0" Padding="13,11">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="电源" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding PowerStateText}" Style="{StaticResource Caption}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding BatteryDisplayText}" FontSize="25"
                                       FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}" />
                            <Ellipse Width="6" Height="6" Fill="{StaticResource GreenBrush}" Margin="7,0,0,0"
                                     VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="{x:Type Ellipse}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding HasBattery}" Value="True" />
                                                    <Condition Binding="{Binding IsCharging}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </StackPanel>
                        <ProgressBar Style="{StaticResource ThinProgress}" Maximum="100"
                                     Value="{Binding BatteryPercent, Mode=OneWay}" Margin="0,6,0,0"
                                     Visibility="{Binding HasBattery, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding BatteryTimeText}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Volume & brightness -->
            <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="13,9">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding MuteGlyph}" FontFamily="{StaticResource IconFont}" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <Slider Grid.Column="1" Style="{StaticResource VolumeSlider}" Margin="8,0" Minimum="0"
                            Maximum="100" Value="{Binding VolumePercent, Mode=OneWay}"
                            ValueChanged="Volume_ValueChanged" />
                    <TextBlock Grid.Column="2" Text="{Binding VolumePercent, StringFormat={}{0:0}%}"
                               FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Width="34" TextAlignment="Right" />

                    <TextBlock Grid.Row="1" Text="&#xE706;" FontFamily="{StaticResource IconFont}" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <Slider x:Name="BrightnessSlider" Grid.Row="1" Grid.Column="1" Style="{StaticResource VolumeSlider}"
                            Margin="8,4,8,0" Minimum="0" Maximum="100"
                            Value="{Binding BrightnessPercent, Mode=OneWay}"
                            IsEnabled="{Binding IsBrightnessAvailable}"
                            ValueChanged="Brightness_ValueChanged"
                            ToolTip="此显示器需要支持 DDC/CI 才能调节亮度" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding BrightnessPercent, StringFormat={}{0:0}%}"
                               FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Width="34" TextAlignment="Right" Margin="0,4,0,0" />
                </Grid>
            </Border>

            <TextBlock Text="设备状态" Style="{StaticResource PaneTitle}" Margin="2,14,0,8" FontSize="13" />
            <WrapPanel>
                <Border Margin="0,0,6,6">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}" BasedOn="{StaticResource Chip}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MicInUse}" Value="True">
                                    <Setter Property="Background" Value="#1AFF453A" />
                                    <Setter Property="BorderBrush" Value="#33FF453A" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE720;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                   Foreground="{StaticResource OrangeBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding MicStatusText}" FontSize="10" Margin="6,0,0,0" />
                    </StackPanel>
                </Border>

                <Border Margin="0,0,6,6">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}" BasedOn="{StaticResource Chip}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CameraInUse}" Value="True">
                                    <Setter Property="Background" Value="#1A30D158" />
                                    <Setter Property="BorderBrush" Value="#3330D158" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE722;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                   Foreground="{StaticResource GreenBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CameraStatusText}" FontSize="10" Margin="6,0,0,0" />
                    </StackPanel>
                </Border>

                <Border Margin="0,0,6,6">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}" BasedOn="{StaticResource Chip}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CapsLockOn}" Value="True">
                                    <Setter Property="Background" Value="#1A6C8CFF" />
                                    <Setter Property="BorderBrush" Value="#336C8CFF" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="A" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CapsStatusText}" FontSize="10" Margin="6,0,0,0" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <StackPanel Margin="2,4,2,0">
                <Grid Margin="0,0,0,5">
                    <TextBlock Text="网络适配器" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding AdapterText}" FontSize="10" HorizontalAlignment="Right"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </Grid>
                <Grid Margin="0,0,0,5">
                    <TextBlock Text="磁盘" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding DiskText}" FontSize="10" HorizontalAlignment="Right"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </Grid>
                <Grid Margin="0,0,0,5">
                    <TextBlock Text="运行时间" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding UptimeText}" FontSize="10" HorizontalAlignment="Right"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
