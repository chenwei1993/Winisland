<UserControl x:Class="WinIsland.Panes.ShelfView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="448">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="文件架" Style="{StaticResource PaneTitle}" />
                <TextBlock Text="{Binding ShelfCountText}" Style="{StaticResource Caption}"
                           VerticalAlignment="Bottom" Margin="8,0,0,2" />
            </StackPanel>
            <Button Content="清空" Style="{StaticResource GhostButton}" Padding="10,5"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Click="Clear_Click"
                    IsEnabled="{Binding HasShelf}" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4" Margin="0,0,0,9">
            <Grid Height="52">
                <Rectangle Margin="3" Stroke="#336C8CFF" StrokeThickness="1" StrokeDashArray="3 3"
                           RadiusX="10" RadiusY="10" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="15"
                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="把文件拖到岛上，随手带走" FontSize="10.5"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding HasShelf, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding ShelfItems}" Margin="0,0,4,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="9" Margin="0,0,0,7" Cursor="Hand"
                                    ToolTip="{Binding Path}"
                                    PreviewMouseLeftButtonDown="Item_PreviewMouseLeftButtonDown"
                                    MouseMove="Item_MouseMove">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="9"
                                            Background="{StaticResource IconTileBrush}">
                                        <Grid>
                                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}"
                                                       FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Border CornerRadius="9"
                                                    Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVis}}">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding Thumbnail}"
                                                                Stretch="UniformToFill" />
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="11"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding SizeText}" FontSize="9"
                                                   Foreground="{StaticResource TextTertiaryBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource SmallIconButton}"
                                            Content="&#xE72A;" Click="Open_Click" ToolTip="打开" />
                                    <Button Grid.Column="3" Style="{StaticResource SmallIconButton}"
                                            Content="&#xE711;" Click="Remove_Click" ToolTip="移除" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding HasShelf, Converter={StaticResource InverseBoolToVis}}">
                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="30"
                           Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="把文件拖到灵动岛上" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"
                           Margin="0,8,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
