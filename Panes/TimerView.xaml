<UserControl x:Class="WinIsland.Panes.TimerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ctrl="clr-namespace:WinIsland.Controls"
             mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="448">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="#12FFFFFF" CornerRadius="10" Padding="3" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="TabCountdown" Style="{StaticResource SegmentButton}" Content="倒计时"
                             GroupName="TimerMode" IsChecked="True" Checked="Mode_Changed" />
                <RadioButton x:Name="TabStopwatch" Style="{StaticResource SegmentButton}" Content="秒表"
                             GroupName="TimerMode" Checked="Mode_Changed" />
                <RadioButton x:Name="TabReminder" Style="{StaticResource SegmentButton}" Content="提醒"
                             GroupName="TimerMode" Checked="Mode_Changed" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <!-- Countdown -->
            <StackPanel x:Name="CountdownPanel" VerticalAlignment="Center">
                <Grid Width="192" Height="192" HorizontalAlignment="Center">
                    <ctrl:RingProgress Value="{Binding CountdownProgress}" Thickness="9"
                                       Foreground="{StaticResource AccentBrush}" TrackBrush="#1FFFFFFF" />
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding CountdownText}" FontSize="38" FontWeight="SemiBold"
                                   FontFamily="{StaticResource DisplayFont}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding CountdownLabel}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"
                                   Margin="0,2,0,0" />
                        <TextBlock Text="{Binding CountdownStatusText}" FontSize="10.5"
                                   Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>

                <WrapPanel HorizontalAlignment="Center" Margin="0,12,0,0">
                    <Button Content="1 分钟" Style="{StaticResource GhostButton}" Margin="3" Click="Preset1_Click" />
                    <Button Content="3 分钟" Style="{StaticResource GhostButton}" Margin="3" Click="Preset3_Click" />
                    <Button Content="5 分钟" Style="{StaticResource GhostButton}" Margin="3" Click="Preset5_Click" />
                    <Button Content="10 分钟" Style="{StaticResource GhostButton}" Margin="3" Click="Preset10_Click" />
                    <Button Content="25 分钟" Style="{StaticResource GhostButton}" Margin="3" Click="Preset25_Click" />
                </WrapPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button x:Name="CountdownToggle" Content="{Binding CountdownButtonText}"
                            Style="{StaticResource PrimaryButton}" Width="94" Click="CountdownToggle_Click" />
                    <Button Content="重置" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                            Click="CountdownReset_Click" />
                    <Button Content="+1 分" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                            Click="CountdownAdd_Click" />
                </StackPanel>
            </StackPanel>

            <!-- Stopwatch -->
            <StackPanel x:Name="StopwatchPanel" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock Text="{Binding StopwatchText}" FontSize="58" FontWeight="Light"
                           FontFamily="{StaticResource DisplayFont}" HorizontalAlignment="Center" />
                <TextBlock Text="秒表" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}"
                           HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                    <Button Content="{Binding StopwatchButtonText}" Style="{StaticResource PrimaryButton}"
                            Width="94" Click="StopwatchToggle_Click" />
                    <Button Content="重置" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                            Click="StopwatchReset_Click" />
                </StackPanel>
            </StackPanel>

            <!-- Scheduled reminder -->
            <ScrollViewer x:Name="ReminderPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Margin="0,2,4,0">
                <StackPanel Margin="0,4,0,0">
                    <TextBlock Text="到点后会常驻在岛上，点击「关闭提醒」才会消失"
                               Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    <TextBox x:Name="ReminderTitleBox" Style="{StaticResource FieldBox}" Tag="提醒内容（可选）"
                             Margin="0,10,0,0" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ReminderTimeBox" Style="{StaticResource FieldBox}" Tag="时间 HH:mm"
                                 Text="21:00" />
                        <Button Grid.Column="1" Content="添加提醒" Style="{StaticResource PrimaryButton}"
                                Margin="8,0,0,0" Click="ReminderAdd_Click" />
                    </Grid>
                    <TextBlock x:Name="ReminderHint" Style="{StaticResource Caption}" Margin="2,5,0,0"
                               TextWrapping="Wrap"
                               Text="输入 HH:mm；今天已过的时间会自动安排到明天" />

                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="5 分钟后" Style="{StaticResource GhostButton}" Margin="0,0,6,6"
                                Click="ReminderQuick5_Click" />
                        <Button Content="15 分钟后" Style="{StaticResource GhostButton}" Margin="0,0,6,6"
                                Click="ReminderQuick15_Click" />
                        <Button Content="30 分钟后" Style="{StaticResource GhostButton}" Margin="0,0,6,6"
                                Click="ReminderQuick30_Click" />
                        <Button Content="1 小时后" Style="{StaticResource GhostButton}" Margin="0,0,6,6"
                                Click="ReminderQuick60_Click" />
                    </WrapPanel>

                    <ItemsControl ItemsSource="{Binding Reminders.Reminders}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="10,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="12.5"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding TargetText}"
                                                       Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                                                   Style="{StaticResource Caption}"
                                                   VerticalAlignment="Center" Margin="10,0" />
                                        <Button Grid.Column="2" Content="{Binding ActionText}"
                                                Style="{StaticResource GhostButton}" Padding="10,4"
                                                Click="ReminderAction_Click" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="还没有提醒" Style="{StaticResource Caption}" Margin="2,6,0,0"
                               Visibility="{Binding Reminders.HasReminders, Converter={StaticResource InverseBoolToVis}}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <TextBlock Grid.Row="2" Style="{StaticResource HintText}"
                   Text="提示：倒计时和提醒会常驻灵动岛，随时一眼可见。"
                   HorizontalAlignment="Center" />
    </Grid>
</UserControl>
