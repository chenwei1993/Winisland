<UserControl x:Class="WinIsland.Panes.TimerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ctrl="clr-namespace:WinIsland.Controls"
             mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="448">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="#12FFFFFF" CornerRadius="10" Padding="3" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="TabCountdown" Style="{StaticResource SegmentButton}" Content="倒计时"
                             GroupName="TimerMode" IsChecked="True" Checked="Mode_Changed" />
                <RadioButton x:Name="TabStopwatch" Style="{StaticResource SegmentButton}" Content="秒表"
                             GroupName="TimerMode" Checked="Mode_Changed" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <!-- Countdown -->
            <StackPanel x:Name="CountdownPanel" VerticalAlignment="Center">
                <Grid Width="192" Height="192" HorizontalAlignment="Center">
                    <ctrl:RingProgress Value="{Binding CountdownProgress}" Thickness="9"
                                       Foreground="{StaticResource AccentBrush}" TrackBrush="#1FFFFFFF" />
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding CountdownText}" FontSize="34" FontWeight="SemiBold"
                                   FontFamily="{StaticResource DisplayFont}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding CountdownLabel}" FontSize="10.5"
                                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"
                                   Margin="0,2,0,0" />
                        <TextBlock Text="{Binding CountdownStatusText}" FontSize="9.5"
                                   Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>

                <WrapPanel HorizontalAlignment="Center" Margin="0,12,0,0">
                    <Button Content="1 分钟" Style="{StaticResource GhostButton}" Margin="3" Click="Preset1_Click" />
                    <Button Content="3 分钟" Style="{StaticResource GhostButton}" Margin="3" Click="Preset3_Click" />
                    <Button Content="5 分钟" Style="{StaticResource GhostButton}" Margin="3" Click="Preset5_Click" />
                    <Button Content="10 分钟" Style="{StaticResource GhostButton}" Margin="3" Click="Preset10_Click" />
                    <Button Content="25 分钟" Style="{StaticResource GhostButton}" Margin="3" Click="Preset25_Click" />
                </WrapPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button x:Name="CountdownToggle" Content="{Binding CountdownButtonText}"
                            Style="{StaticResource PrimaryButton}" Width="94" Click="CountdownToggle_Click" />
                    <Button Content="重置" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                            Click="CountdownReset_Click" />
                    <Button Content="+1 分" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                            Click="CountdownAdd_Click" />
                </StackPanel>
            </StackPanel>

            <!-- Stopwatch -->
            <StackPanel x:Name="StopwatchPanel" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock Text="{Binding StopwatchText}" FontSize="52" FontWeight="Light"
                           FontFamily="{StaticResource DisplayFont}" HorizontalAlignment="Center" />
                <TextBlock Text="秒表" FontSize="10.5" Foreground="{StaticResource TextTertiaryBrush}"
                           HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                    <Button Content="{Binding StopwatchButtonText}" Style="{StaticResource PrimaryButton}"
                            Width="94" Click="StopwatchToggle_Click" />
                    <Button Content="重置" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                            Click="StopwatchReset_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="2" Style="{StaticResource HintText}"
                   Text="提示：倒计时会常驻灵动岛，随时可以在岛上一眼看到剩余时间。"
                   HorizontalAlignment="Center" />
    </Grid>
</UserControl>
