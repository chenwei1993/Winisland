<UserControl x:Class="WinIsland.Panes.AlertsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="448">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="通知" Style="{StaticResource PaneTitle}" />
                <TextBlock Text="{Binding AlertCountText}" Style="{StaticResource Caption}"
                           VerticalAlignment="Bottom" Margin="8,0,0,2" />
            </StackPanel>
            <Button Content="全部清除" Style="{StaticResource GhostButton}" Padding="10,5"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Click="Clear_Click"
                    IsEnabled="{Binding HasAlerts}" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding HasAlerts, Converter={StaticResource BoolToVis}}">
            <ItemsControl ItemsSource="{Binding Alerts}" Margin="0,0,4,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,7"
                                MouseLeftButtonUp="Item_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="icon" Width="32" Height="32" CornerRadius="16"
                                        Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Top">
                                    <Grid>
                                        <TextBlock x:Name="glyph" Text="{Binding Glyph}"
                                                   FontFamily="{StaticResource IconFont}" FontSize="14"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image Source="{Binding Icon}" Stretch="UniformToFill">
                                            <Image.Clip>
                                                <EllipseGeometry Center="16,16" RadiusX="16" RadiusY="16" />
                                            </Image.Clip>
                                        </Image>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,6,0">
                                    <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Message}" FontSize="10"
                                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                               MaxHeight="32" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding MetaText}" FontSize="9"
                                               Foreground="{StaticResource TextTertiaryBrush}" Margin="0,3,0,0" />
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource SmallIconButton}" Content="&#xE711;"
                                        Click="Remove_Click" ToolTip="移除" VerticalAlignment="Top" />
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="success">
                                <Setter TargetName="icon" Property="Background" Value="#1A30D158" />
                                <Setter TargetName="glyph" Property="Foreground" Value="{StaticResource GreenBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="warning">
                                <Setter TargetName="icon" Property="Background" Value="#1AFF9F0A" />
                                <Setter TargetName="glyph" Property="Foreground" Value="{StaticResource OrangeBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="error">
                                <Setter TargetName="icon" Property="Background" Value="#1AFF453A" />
                                <Setter TargetName="glyph" Property="Foreground" Value="{StaticResource RedBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="timer">
                                <Setter TargetName="icon" Property="Background" Value="#1AB06CFF" />
                                <Setter TargetName="glyph" Property="Foreground" Value="{StaticResource PurpleBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding HasAlerts, Converter={StaticResource InverseBoolToVis}}">
            <Border Width="70" Height="70" CornerRadius="20" Background="{StaticResource IconTileBrush}"
                    HorizontalAlignment="Center">
                <TextBlock Text="&#xEA8F;" FontFamily="{StaticResource IconFont}" FontSize="26"
                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="暂无通知" FontSize="14" FontWeight="SemiBold"
                       FontFamily="{StaticResource DisplayFont}" HorizontalAlignment="Center" Margin="0,14,0,4" />
            <TextBlock Text="任何程序都可以把消息推送到灵动岛" FontSize="10.5"
                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="命令行：WinIsland.exe --notify &quot;标题&quot; &quot;内容&quot;" FontSize="9.5"
                       Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center"
                       Margin="0,6,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
