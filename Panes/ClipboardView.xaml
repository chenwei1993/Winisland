<UserControl x:Class="WinIsland.Panes.ClipboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="448">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="剪贴板" Style="{StaticResource PaneTitle}" />
                <TextBlock Text="{Binding ClipboardCountText}" Style="{StaticResource Caption}"
                           VerticalAlignment="Bottom" Margin="8,0,0,2" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="{Binding ClipboardToggleText}" Style="{StaticResource GhostButton}"
                        Padding="10,5" Click="Pause_Click" />
                <Button Content="清空" Style="{StaticResource GhostButton}" Padding="10,5" Margin="6,0,0,0"
                        Click="Clear_Click" IsEnabled="{Binding HasClipboard}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding HasClipboard, Converter={StaticResource BoolToVis}}">
            <ItemsControl ItemsSource="{Binding ClipboardItems}" Margin="0,0,4,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,7" Cursor="Hand"
                                MouseLeftButtonUp="Item_Click">
                            <Border.ToolTip>
                                <TextBlock Text="{Binding Tooltip}" MaxWidth="340" TextWrapping="Wrap" />
                            </Border.ToolTip>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="9" Background="#12FFFFFF"
                                        VerticalAlignment="Top">
                                    <Grid>
                                        <TextBlock Text="{Binding KindGlyph}" FontFamily="{StaticResource IconFont}"
                                                   FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Border CornerRadius="9"
                                                Visibility="{Binding Thumbnail, Converter={StaticResource NotNullToVis}}">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,6,0">
                                    <TextBlock Text="{Binding Preview}" FontSize="11" TextWrapping="Wrap"
                                               MaxHeight="36" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding MetaText}" FontSize="9"
                                               Foreground="{StaticResource TextTertiaryBrush}" Margin="0,3,0,0" />
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource SmallIconButton}" Content="&#xE711;"
                                        Click="Delete_Click" ToolTip="移除" VerticalAlignment="Top" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding HasClipboard, Converter={StaticResource InverseBoolToVis}}">
            <Border Width="70" Height="70" CornerRadius="20" Background="{StaticResource IconTileBrush}"
                    HorizontalAlignment="Center">
                <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="26"
                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="剪贴板空空如也" FontSize="14" FontWeight="SemiBold"
                       FontFamily="{StaticResource DisplayFont}" HorizontalAlignment="Center" Margin="0,14,0,4" />
            <TextBlock Text="复制任意文本、图片或文件后，会自动出现在这里" FontSize="10.5"
                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
