<UserControl x:Class="WinIsland.Panes.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="448">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="MonthText" Text="2026年10月" FontSize="15" FontWeight="SemiBold"
                           FontFamily="{StaticResource DisplayFont}" VerticalAlignment="Center" />
                <Border x:Name="TodayBadge" Background="{StaticResource AccentSoftBrush}" CornerRadius="6" Padding="6,2"
                        Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="本月" FontSize="9" Foreground="{StaticResource AccentBrush}" />
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource IconButton}" Content="&#xE76B;" Width="28" Height="28"
                        Click="Previous_Click" ToolTip="上个月" />
                <Button Content="今天" Style="{StaticResource GhostButton}" Padding="10,5" Margin="3,0"
                        Click="Today_Click" />
                <Button Style="{StaticResource IconButton}" Content="&#xE76C;" Width="28" Height="28"
                        Click="Next_Click" ToolTip="下个月" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="一" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="二" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="三" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="四" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
            <TextBlock Grid.Column="4" Text="五" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
            <TextBlock Grid.Column="5" Text="六" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
            <TextBlock Grid.Column="6" Text="日" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
        </Grid>

        <ItemsControl x:Name="Days" Grid.Row="2">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="7" Rows="6" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="cell" Width="36" Height="36" CornerRadius="18" Background="Transparent"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="dayText" Text="{Binding Day}" FontSize="12"
                                   Foreground="#5CFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsCurrentMonth}" Value="True">
                            <Setter TargetName="dayText" Property="Foreground" Value="#E6FFFFFF" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                            <Setter TargetName="cell" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="dayText" Property="Foreground" Value="#0A0A0C" />
                            <Setter TargetName="dayText" Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="14,10" Margin="0,10,0,0">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding FullDateText}" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding WeekText}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TimeWithSecondsText}" FontSize="26" FontWeight="SemiBold"
                               FontFamily="{StaticResource DisplayFont}" HorizontalAlignment="Right" />
                    <TextBlock Text="本地时间" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
