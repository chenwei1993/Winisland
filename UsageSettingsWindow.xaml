<Window x:Class="WinIsland.UsageSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 用量设置" Width="620" Height="700"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" FontSize="12"
        Foreground="{StaticResource TextPrimaryBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        KeyDown="Window_KeyDown">
    <Border Background="#F518181B" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="18"
            Padding="20,16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel>
                    <TextBlock Text="AI 用量设置" Style="{StaticResource PaneTitle}" FontSize="16" />
                    <TextBlock Text="每个平台单独配置 Key；Key 使用 Windows DPAPI 加密保存在本机"
                               Style="{StaticResource Caption}" FontSize="11.5" Margin="0,2,0,0" />
                </StackPanel>
                <Button Content="&#xE711;" Style="{StaticResource SmallIconButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Click="Close_Click"
                        ToolTip="关闭" />
            </Grid>

            <ScrollViewer Grid.Row="1" Margin="0,12,0,8" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,4,0">
                    <Border Style="{StaticResource Card}" Padding="12,9" Margin="0,0,0,4">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="启用用量监控" FontSize="13" />
                                <TextBlock Text="关闭后不再请求各平台接口，已有数据仍保留"
                                           Style="{StaticResource Caption}" FontSize="11" Margin="0,3,0,0" />
                            </StackPanel>
                            <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding ViewModel.UsageEnabled, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="13,10" Margin="0,8,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="24" Height="24" CornerRadius="8"
                                                        Background="#1F6C8CFF">
                                                    <TextBlock Text="{Binding Glyph}" FontSize="13"
                                                               Foreground="{StaticResource AccentBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Margin="9,0,0,0">
                                                    <TextBlock Text="{Binding Name}" FontSize="13"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Description}"
                                                               Style="{StaticResource Caption}"
                                                               FontSize="11" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                        VerticalAlignment="Center">
                                                <Button Content="&#xE70E;" Style="{StaticResource SmallIconButton}"
                                                        ToolTip="上移" Click="MoveUp_Click" />
                                                <Button Content="&#xE70D;" Style="{StaticResource SmallIconButton}"
                                                        ToolTip="下移" Click="MoveDown_Click" />
                                                <CheckBox Style="{StaticResource Switch}" Margin="8,0,0,0"
                                                          VerticalAlignment="Center"
                                                          ToolTip="在用量页显示该平台"
                                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBox Style="{StaticResource FieldBox}" Margin="0,9,0,0" Tag="粘贴 API Key"
                                                 Text="{Binding KeyInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <Grid Margin="0,7,0,0">
                                            <TextBlock Text="{Binding KeyStatus}" Style="{StaticResource Caption}"
                                                       FontSize="11" VerticalAlignment="Center" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="保存" Style="{StaticResource GhostButton}"
                                                        FontSize="12" Click="SaveKey_Click" />
                                                <Button Content="清除" Style="{StaticResource GhostButton}"
                                                        FontSize="12" Margin="6,0,0,0" Click="ClearKey_Click" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="{Binding EnvironmentHint}" Style="{StaticResource Caption}"
                                                   FontSize="10.5" Margin="0,5,0,0" TextWrapping="Wrap"
                                                   Visibility="{Binding HasEnvironmentKey, Converter={StaticResource BoolToVis}}" />

                                        <StackPanel Margin="0,9,0,0"
                                                    Visibility="{Binding HasBalanceSettings, Converter={StaticResource BoolToVis}}">
                                            <Grid>
                                                <TextBlock Text="月度预算" FontSize="12.5" VerticalAlignment="Center" />
                                                <TextBox Width="104" HorizontalAlignment="Right"
                                                         Style="{StaticResource FieldBox}"
                                                         Text="{Binding Budget, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}" />
                                            </Grid>
                                            <TextBlock Text="把余额换算成百分比；填 0 表示只显示金额"
                                                       Style="{StaticResource Caption}" FontSize="10.5" Margin="0,3,0,0" />
                                            <Grid Margin="0,8,0,0">
                                                <TextBlock Text="余额提醒阈值" FontSize="12.5"
                                                           VerticalAlignment="Center" />
                                                <TextBox Width="104" HorizontalAlignment="Right"
                                                         Style="{StaticResource FieldBox}"
                                                         Text="{Binding LowBalance, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}" />
                                            </Grid>
                                            <TextBlock Text="余额低于该金额时提醒一次（每天最多一次）"
                                                       Style="{StaticResource Caption}" FontSize="10.5" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource Card}" Padding="12,9" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="岛上显示" FontSize="13" />
                            <TextBlock Text="仅告警时：额度或余额紧张才出现；总是显示：一直保留一个小徽标"
                                       Style="{StaticResource Caption}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" />
                            <WrapPanel Margin="0,7,0,0">
                                <RadioButton Style="{StaticResource SegmentButton}" Content="仅告警时"
                                             FontSize="12" GroupName="UsageIsland"
                                             IsChecked="{Binding ViewModel.UsageIslandAlertsOnly, Mode=TwoWay}" />
                                <RadioButton Style="{StaticResource SegmentButton}" Content="总是显示"
                                             FontSize="12" GroupName="UsageIsland"
                                             IsChecked="{Binding ViewModel.UsageIslandAlways, Mode=TwoWay}" />
                                <RadioButton Style="{StaticResource SegmentButton}" Content="不显示"
                                             FontSize="12" GroupName="UsageIsland"
                                             IsChecked="{Binding ViewModel.UsageIslandOff, Mode=TwoWay}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="12,9" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="告警阈值" FontSize="13" />
                            <TextBlock Text="某个额度窗口已用到该比例时上岛提醒一次"
                                       Style="{StaticResource Caption}" FontSize="11" Margin="0,3,0,0" />
                            <WrapPanel Margin="0,7,0,0">
                                <RadioButton Style="{StaticResource SegmentButton}" Content="70%"
                                             FontSize="12" GroupName="UsageWarn"
                                             IsChecked="{Binding ViewModel.UsageWarn70, Mode=TwoWay}" />
                                <RadioButton Style="{StaticResource SegmentButton}" Content="80%"
                                             FontSize="12" GroupName="UsageWarn"
                                             IsChecked="{Binding ViewModel.UsageWarn80, Mode=TwoWay}" />
                                <RadioButton Style="{StaticResource SegmentButton}" Content="90%"
                                             FontSize="12" GroupName="UsageWarn"
                                             IsChecked="{Binding ViewModel.UsageWarn90, Mode=TwoWay}" />
                                <RadioButton Style="{StaticResource SegmentButton}" Content="95%"
                                             FontSize="12" GroupName="UsageWarn"
                                             IsChecked="{Binding ViewModel.UsageWarn95, Mode=TwoWay}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="12,9" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="刷新间隔" FontSize="13" />
                            <TextBlock Text="多久请求一次各平台接口；失败时会自动减慢重试"
                                       Style="{StaticResource Caption}" FontSize="11" Margin="0,3,0,0" />
                            <WrapPanel Margin="0,7,0,0">
                                <RadioButton Style="{StaticResource SegmentButton}" Content="1 分钟"
                                             FontSize="12" GroupName="UsageRefresh"
                                             IsChecked="{Binding ViewModel.UsageRefresh1, Mode=TwoWay}" />
                                <RadioButton Style="{StaticResource SegmentButton}" Content="2 分钟"
                                             FontSize="12" GroupName="UsageRefresh"
                                             IsChecked="{Binding ViewModel.UsageRefresh2, Mode=TwoWay}" />
                                <RadioButton Style="{StaticResource SegmentButton}" Content="5 分钟"
                                             FontSize="12" GroupName="UsageRefresh"
                                             IsChecked="{Binding ViewModel.UsageRefresh5, Mode=TwoWay}" />
                                <RadioButton Style="{StaticResource SegmentButton}" Content="10 分钟"
                                             FontSize="12" GroupName="UsageRefresh"
                                             IsChecked="{Binding ViewModel.UsageRefresh10, Mode=TwoWay}" />
                                <RadioButton Style="{StaticResource SegmentButton}" Content="15 分钟"
                                             FontSize="12" GroupName="UsageRefresh"
                                             IsChecked="{Binding ViewModel.UsageRefresh15, Mode=TwoWay}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2">
                <TextBlock Text="保存后立即生效，无需重启" Style="{StaticResource Caption}"
                           FontSize="11" VerticalAlignment="Center" />
                <Button Content="完成" Style="{StaticResource PrimaryButton}" FontSize="12.5"
                        HorizontalAlignment="Right" Click="Close_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
