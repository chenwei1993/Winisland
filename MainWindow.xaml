<Window x:Class="WinIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ctrl="clr-namespace:WinIsland.Controls"
        mc:Ignorable="d"
        Title="WinIsland"
        Width="348" Height="50"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        AllowDrop="True"
        FontFamily="{StaticResource UiFont}"
        FontSize="13.5"
        Foreground="{StaticResource TextPrimaryBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop"
        KeyDown="Window_KeyDown"
        Deactivated="Window_Deactivated"
        Closing="Window_Closing">

    <Grid Background="Transparent">
        <Border x:Name="IslandBorder" Width="348" Height="50" HorizontalAlignment="Center"
                VerticalAlignment="Top" Background="#FF0A0A0C" BorderThickness="1" CornerRadius="23"
                ClipToBounds="True"
                MouseLeftButtonUp="Island_MouseLeftButtonUp"
                MouseRightButtonUp="Island_MouseRightButtonUp"
                MouseEnter="Island_MouseEnter">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="BorderBrush" Value="#1AFFFFFF" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="#38FFFFFF" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <!-- ── Idle ─────────────────────────────────────────────── -->
                <Grid x:Name="IdleFace" Height="50" HorizontalAlignment="Center"
                      VerticalAlignment="Top" Cursor="Hand" IsHitTestVisible="True">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Margin="16,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TimeText}" FontSize="17" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Ellipse Width="3" Height="3" Fill="{StaticResource TextTertiaryBrush}"
                                     Margin="8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DateText}" FontSize="12.5"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0"
                                    Visibility="{Binding HasIdleStatus, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="&#xE720;" FontFamily="{StaticResource IconFont}" FontSize="13.5"
                                       Foreground="{StaticResource RedBrush}" VerticalAlignment="Center" Margin="0,0,5,0"
                                       ToolTip="麦克风正在使用"
                                       Visibility="{Binding MicInUse, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="&#xE722;" FontFamily="{StaticResource IconFont}" FontSize="13.5"
                                       Foreground="{StaticResource GreenBrush}" VerticalAlignment="Center" Margin="0,0,5,0"
                                       ToolTip="摄像头正在使用"
                                       Visibility="{Binding CameraInUse, Converter={StaticResource BoolToVis}}" />
                            <Border Background="#1F6C8CFF" CornerRadius="3" Padding="3,1" Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding CapsLockOn, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="A" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}" />
                            </Border>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding HasBattery, Converter={StaticResource BoolToVis}}">
                                <Border Width="20" Height="10" CornerRadius="2.5" BorderBrush="#59FFFFFF"
                                        BorderThickness="1" Margin="0,0,5,0" VerticalAlignment="Center">
                                    <Grid Margin="1.5">
                                        <Border Height="5" CornerRadius="1" HorizontalAlignment="Left"
                                                Width="{Binding BatteryPercent, Converter={StaticResource BatteryFillWidth}}">
                                            <Border.Style>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="Background" Value="#D9FFFFFF" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCharging}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource GreenBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding BatteryPercent, StringFormat={}{0}%}" FontSize="12.5"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0"
                                        ToolTip="{Binding Buds.DetailText}"
                                        Visibility="{Binding Buds.HasBattery, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="&#xE7F6;" FontFamily="{StaticResource IconFont}" FontSize="13.5"
                                           Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Buds.CompactText}" FontSize="12.5"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="4,0,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <Border Margin="18,0,0,0" Padding="7,3" CornerRadius="7" VerticalAlignment="Center"
                                ToolTip="{Binding Usage.ChipTooltip}"
                                MouseLeftButtonUp="UsageChip_Click"
                                Visibility="{Binding Usage.HasChip, Converter={StaticResource BoolToVis}}">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Background" Value="#1F6C8CFF" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Usage.ChipLevel}" Value="1">
                                            <Setter Property="Background" Value="#26FF9F0A" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Usage.ChipLevel}" Value="2">
                                            <Setter Property="Background" Value="#26FF453A" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Usage.ChipGlyph}" FontSize="12.5" VerticalAlignment="Center"
                                           Margin="0,0,4,0">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Usage.ChipLevel}" Value="1">
                                                    <Setter Property="Foreground" Value="{StaticResource OrangeBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Usage.ChipLevel}" Value="2">
                                                    <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Usage.ChipText}" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ── Compact live activity ─────────────────────────────── -->
                <Grid x:Name="CompactFace" Width="500" Height="66" HorizontalAlignment="Center"
                      VerticalAlignment="Top" Visibility="Collapsed" Opacity="0" Cursor="Hand"
                      IsHitTestVisible="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="14,8,14,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Width="38" Height="38" VerticalAlignment="Center">
                            <Border x:Name="CompactArtTile" CornerRadius="11" Background="{StaticResource IconTileBrush}">
                                <TextBlock x:Name="CompactGlyph" Text="&#xE768;"
                                           FontFamily="{StaticResource IconFont}" FontSize="19"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="CompactArtHost" CornerRadius="11" Visibility="Collapsed">
                                <Border.Background>
                                    <ImageBrush x:Name="CompactArtBrush" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                        </Grid>

                        <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                            <TextBlock x:Name="CompactTitle" FontSize="15.5" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="CompactSubtitle" FontSize="12.5"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0"
                                        ToolTip="{Binding Buds.DetailText}"
                                        Visibility="{Binding Buds.HasBattery, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="&#xE7F6;" FontFamily="{StaticResource IconFont}" FontSize="12.5"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Buds.CompactText}" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="3,0,0,0" />
                            </StackPanel>
                            <ctrl:RingProgress x:Name="CompactRing" Width="34" Height="34" Thickness="3.5"
                                               Foreground="{StaticResource AccentBrush}" Visibility="Collapsed" />
                            <Grid x:Name="CompactEqualizer" Width="20" Height="20" Margin="7,0,5,0"
                                  Visibility="Collapsed" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <Border x:Name="BarA" Width="3" Height="10" CornerRadius="1.5"
                                            Background="{StaticResource TextPrimaryBrush}" Margin="0,0,3,0"
                                            RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleY="1" />
                                        </Border.RenderTransform>
                                    </Border>
                                    <Border x:Name="BarB" Width="3" Height="10" CornerRadius="1.5"
                                            Background="{StaticResource TextPrimaryBrush}" Margin="0,0,3,0"
                                            RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleY="1" />
                                        </Border.RenderTransform>
                                    </Border>
                                    <Border x:Name="BarC" Width="3" Height="10" CornerRadius="1.5"
                                            Background="{StaticResource TextPrimaryBrush}"
                                            RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleY="1" />
                                        </Border.RenderTransform>
                                    </Border>
                                </StackPanel>
                                <Grid.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetName="BarA"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                 From="0.5" To="1.8" Duration="0:0:0.45" />
                                                <DoubleAnimation Storyboard.TargetName="BarB"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                 From="1.7" To="0.45" Duration="0:0:0.5"
                                                                 BeginTime="0:0:0.08" />
                                                <DoubleAnimation Storyboard.TargetName="BarC"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                 From="0.7" To="1.9" Duration="0:0:0.38"
                                                                 BeginTime="0:0:0.16" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Grid.Triggers>
                            </Grid>
                            <Button x:Name="CompactPlayButton" Style="{StaticResource IconButton}"
                                    Width="34" Height="34" FontSize="20" Visibility="Collapsed"
                                    Click="CompactPlay_Click" />
                        </StackPanel>
                    </Grid>

                    <ProgressBar x:Name="CompactBar" Grid.Row="1" Style="{StaticResource HudProgress}"
                                 Height="2.5" Margin="20,0,20,6" Maximum="100" Visibility="Collapsed" />

                    <!-- Transparent drag surface over the thin progress bar. -->
                    <Border x:Name="CompactSeekHit" Grid.RowSpan="2" Height="16" VerticalAlignment="Bottom"
                            Margin="20,0,20,0" Background="Transparent" Cursor="Hand" Visibility="Collapsed"
                            PreviewMouseLeftButtonDown="CompactSeek_Down"
                            PreviewMouseMove="CompactSeek_Move"
                            PreviewMouseLeftButtonUp="CompactSeek_Up"
                            LostMouseCapture="CompactSeek_Lost" />
                </Grid>

                <!-- ── Edge sliver ───────────────────────────────────────── -->
                <Grid x:Name="SliverFace" Width="140" Height="5" HorizontalAlignment="Center"
                      VerticalAlignment="Top" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                    <Border Width="52" Height="2.5" CornerRadius="1.25" Background="{StaticResource AccentGradientBrush}"
                            Opacity="0.8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <!-- ── Drop zone ─────────────────────────────────────────── -->
                <Grid x:Name="DropFace" Width="480" Height="140" HorizontalAlignment="Center"
                      VerticalAlignment="Top" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                    <Rectangle Margin="10" Stroke="#666C8CFF" StrokeThickness="1.4" StrokeDashArray="4 4"
                               RadiusX="22" RadiusY="22" />
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="31.5"
                                   Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="松手，放到文件架上" FontSize="15" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,8,0,0" />
                        <TextBlock Text="支持任意文件与文件夹" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <!-- ── Expanded panel ────────────────────────────────────── -->
                <Grid x:Name="ExpandedFace" Width="680" Height="590" HorizontalAlignment="Center"
                      VerticalAlignment="Top" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="62" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="22,0,16,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="7" Height="7" CornerRadius="4" Background="{StaticResource AccentBrush}"
                                    Margin="0,0,8,0" />
                            <TextBlock Text="WINISLAND" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="&#xE720;" FontFamily="{StaticResource IconFont}" FontSize="12.5"
                                       Foreground="{StaticResource OrangeBrush}" VerticalAlignment="Center"
                                       Margin="12,0,0,0" ToolTip="麦克风正在使用"
                                       Visibility="{Binding MicInUse, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="&#xE722;" FontFamily="{StaticResource IconFont}" FontSize="12.5"
                                       Foreground="{StaticResource GreenBrush}" VerticalAlignment="Center"
                                       Margin="7,0,0,0" ToolTip="摄像头正在使用"
                                       Visibility="{Binding CameraInUse, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TimeText}" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DateText}" FontSize="10.5"
                                       Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"
                                       Margin="7,0,10,0" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE713;" FontSize="15.5"
                                    Click="Settings_Click" ToolTip="设置" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE70E;" FontSize="13.5"
                                    Click="Collapse_Click" ToolTip="收起" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="16,0,16,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="136" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ListBox x:Name="Nav" Style="{StaticResource NavList}" SelectionChanged="Nav_SelectionChanged">
                            <ListBoxItem Style="{StaticResource NavItem}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" Style="{StaticResource NavIcon}" />
                                    <TextBlock Text="正在播放" Style="{StaticResource NavLabel}" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource NavItem}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE823;" Style="{StaticResource NavIcon}" />
                                    <TextBlock Text="计时器" Style="{StaticResource NavLabel}" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource NavItem}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE787;" Style="{StaticResource NavIcon}" />
                                    <TextBlock Text="日历" Style="{StaticResource NavLabel}" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource NavItem}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE770;" Style="{StaticResource NavIcon}" />
                                    <TextBlock Text="系统" Style="{StaticResource NavLabel}" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource NavItem}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D2;" Style="{StaticResource NavIcon}" />
                                    <TextBlock Text="用量" Style="{StaticResource NavLabel}" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource NavItem}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8C8;" Style="{StaticResource NavIcon}" />
                                    <TextBlock Text="剪贴板" Style="{StaticResource NavLabel}" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource NavItem}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;" Style="{StaticResource NavIcon}" />
                                    <TextBlock Text="文件架" Style="{StaticResource NavLabel}" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource NavItem}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xEA8F;" Style="{StaticResource NavIcon}" />
                                    <TextBlock Grid.Column="1" Text="通知" Style="{StaticResource NavLabel}" />
                                    <Border Grid.Column="2" Background="{StaticResource AccentBrush}" CornerRadius="7"
                                            Height="14" MinWidth="14" Padding="4,0" VerticalAlignment="Center"
                                            Visibility="{Binding UnreadVisibility}">
                                        <TextBlock Text="{Binding UnreadCount}" FontSize="9.5" FontWeight="Bold"
                                                   Foreground="#0A0A0C" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource NavItem}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" Style="{StaticResource NavIcon}" />
                                    <TextBlock Text="设置" Style="{StaticResource NavLabel}" />
                                </StackPanel>
                            </ListBoxItem>
                        </ListBox>

                        <Grid x:Name="PaneHost" Grid.Column="1" Margin="14,0,0,0" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
