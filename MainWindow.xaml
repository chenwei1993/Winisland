<Window x:Class="WinIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ctrl="clr-namespace:WinIsland.Controls"
        mc:Ignorable="d"
        Title="WinIsland"
        Width="272" Height="40"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        AllowDrop="True"
        FontFamily="{StaticResource UiFont}"
        FontSize="12"
        Foreground="{StaticResource TextPrimaryBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop"
        KeyDown="Window_KeyDown"
        Deactivated="Window_Deactivated"
        Closing="Window_Closing">

    <Grid Background="Transparent">
        <Border x:Name="IslandBorder" Width="272" Height="40" HorizontalAlignment="Center"
                VerticalAlignment="Top" Background="#FF0A0A0C" BorderThickness="1" CornerRadius="20"
                ClipToBounds="True"
                MouseLeftButtonUp="Island_MouseLeftButtonUp"
                MouseRightButtonUp="Island_MouseRightButtonUp"
                MouseEnter="Island_MouseEnter">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="BorderBrush" Value="#1AFFFFFF" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="#38FFFFFF" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <!-- ── Idle ─────────────────────────────────────────────── -->
                <Grid x:Name="IdleFace" Height="40" HorizontalAlignment="Center"
                      VerticalAlignment="Top" Cursor="Hand" IsHitTestVisible="True">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Margin="14,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TimeText}" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Ellipse Width="3" Height="3" Fill="{StaticResource TextTertiaryBrush}"
                                     Margin="7,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DateText}" FontSize="10"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0"
                                    Visibility="{Binding HasIdleStatus, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="&#xE720;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                       Foreground="{StaticResource RedBrush}" VerticalAlignment="Center" Margin="0,0,5,0"
                                       ToolTip="麦克风正在使用"
                                       Visibility="{Binding MicInUse, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="&#xE722;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                       Foreground="{StaticResource GreenBrush}" VerticalAlignment="Center" Margin="0,0,5,0"
                                       ToolTip="摄像头正在使用"
                                       Visibility="{Binding CameraInUse, Converter={StaticResource BoolToVis}}" />
                            <Border Background="#1F6C8CFF" CornerRadius="3" Padding="3,1" Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding CapsLockOn, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="A" FontSize="8" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}" />
                            </Border>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding HasBattery, Converter={StaticResource BoolToVis}}">
                                <Border Width="18" Height="9" CornerRadius="2.5" BorderBrush="#59FFFFFF"
                                        BorderThickness="1" Margin="0,0,5,0" VerticalAlignment="Center">
                                    <Grid Margin="1.5">
                                        <Border Height="4" CornerRadius="1" HorizontalAlignment="Left"
                                                Width="{Binding BatteryPercent, Converter={StaticResource BatteryFillWidth}}">
                                            <Border.Style>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="Background" Value="#D9FFFFFF" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCharging}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource GreenBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding BatteryPercent, StringFormat={}{0}%}" FontSize="10"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ── Compact live activity ─────────────────────────────── -->
                <Grid x:Name="CompactFace" Width="424" Height="56" HorizontalAlignment="Center"
                      VerticalAlignment="Top" Visibility="Collapsed" Opacity="0" Cursor="Hand"
                      IsHitTestVisible="False">                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="12,7,12,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Width="34" Height="34" VerticalAlignment="Center">
                            <Border x:Name="CompactArtTile" CornerRadius="10" Background="{StaticResource IconTileBrush}">
                                <TextBlock x:Name="CompactGlyph" Text="&#xE768;"
                                           FontFamily="{StaticResource IconFont}" FontSize="15"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="CompactArtHost" CornerRadius="10" Visibility="Collapsed">
                                <Border.Background>
                                    <ImageBrush x:Name="CompactArtBrush" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                        </Grid>

                        <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                            <TextBlock x:Name="CompactTitle" FontSize="12.5" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="CompactSubtitle" FontSize="10"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <ctrl:RingProgress x:Name="CompactRing" Width="30" Height="30" Thickness="3"
                                               Foreground="{StaticResource AccentBrush}" Visibility="Collapsed" />
                            <Grid x:Name="CompactEqualizer" Width="18" Height="18" Margin="6,0,4,0"
                                  Visibility="Collapsed" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <Border x:Name="BarA" Width="3" Height="10" CornerRadius="1.5"
                                            Background="{StaticResource TextPrimaryBrush}" Margin="0,0,3,0"
                                            RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleY="1" />
                                        </Border.RenderTransform>
                                    </Border>
                                    <Border x:Name="BarB" Width="3" Height="10" CornerRadius="1.5"
                                            Background="{StaticResource TextPrimaryBrush}" Margin="0,0,3,0"
                                            RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleY="1" />
                                        </Border.RenderTransform>
                                    </Border>
                                    <Border x:Name="BarC" Width="3" Height="10" CornerRadius="1.5"
                                            Background="{StaticResource TextPrimaryBrush}"
                                            RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleY="1" />
                                        </Border.RenderTransform>
                                    </Border>
                                </StackPanel>
                                <Grid.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetName="BarA"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                 From="0.5" To="1.8" Duration="0:0:0.45" />
                                                <DoubleAnimation Storyboard.TargetName="BarB"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                 From="1.7" To="0.45" Duration="0:0:0.5"
                                                                 BeginTime="0:0:0.08" />
                                                <DoubleAnimation Storyboard.TargetName="BarC"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                 From="0.7" To="1.9" Duration="0:0:0.38"
                                                                 BeginTime="0:0:0.16" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Grid.Triggers>
                            </Grid>
                            <Button x:Name="CompactPlayButton" Style="{StaticResource IconButton}"
                                    Width="30" Height="30" FontSize="16" Visibility="Collapsed"
                                    Click="CompactPlay_Click" />
                        </StackPanel>
                    </Grid>

                    <ProgressBar x:Name="CompactBar" Grid.Row="1" Style="{StaticResource HudProgress}"
                                 Height="2" Margin="18,0,18,5" Maximum="100" Visibility="Collapsed" />

                    <!-- Transparent drag surface over the thin progress bar. -->
                    <Border x:Name="CompactSeekHit" Grid.RowSpan="2" Height="14" VerticalAlignment="Bottom"
                            Margin="18,0,18,0" Background="Transparent" Cursor="Hand" Visibility="Collapsed"
                            PreviewMouseLeftButtonDown="CompactSeek_Down"
                            PreviewMouseMove="CompactSeek_Move"
                            PreviewMouseLeftButtonUp="CompactSeek_Up"
                            LostMouseCapture="CompactSeek_Lost" />
                </Grid>

                <!-- ── Edge sliver ───────────────────────────────────────── -->
                <Grid x:Name="SliverFace" Width="120" Height="4" HorizontalAlignment="Center"
                      VerticalAlignment="Top" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                    <Border Width="44" Height="2" CornerRadius="1" Background="{StaticResource AccentGradientBrush}"
                            Opacity="0.8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <!-- ── Drop zone ─────────────────────────────────────────── -->
                <Grid x:Name="DropFace" Width="420" Height="120" HorizontalAlignment="Center"
                      VerticalAlignment="Top" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                    <Rectangle Margin="10" Stroke="#666C8CFF" StrokeThickness="1.4" StrokeDashArray="4 4"
                               RadiusX="22" RadiusY="22" />
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="26"
                                   Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="松手，放到文件架上" FontSize="12.5" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,8,0,0" />
                        <TextBlock Text="支持任意文件与文件夹" FontSize="9.5"
                                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <!-- ── Expanded panel ────────────────────────────────────── -->
                <Grid x:Name="ExpandedFace" Width="600" Height="520" HorizontalAlignment="Center"
                      VerticalAlignment="Top" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="54" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="20,0,14,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="7" Height="7" CornerRadius="4" Background="{StaticResource AccentBrush}"
                                    Margin="0,0,8,0" />
                            <TextBlock Text="WINISLAND" FontSize="9" FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="&#xE720;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                       Foreground="{StaticResource OrangeBrush}" VerticalAlignment="Center"
                                       Margin="12,0,0,0" ToolTip="麦克风正在使用"
                                       Visibility="{Binding MicInUse, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="&#xE722;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                       Foreground="{StaticResource GreenBrush}" VerticalAlignment="Center"
                                       Margin="7,0,0,0" ToolTip="摄像头正在使用"
                                       Visibility="{Binding CameraInUse, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TimeText}" FontSize="11.5" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DateText}" FontSize="9.5"
                                       Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"
                                       Margin="7,0,10,0" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE713;" FontSize="14"
                                    Click="Settings_Click" ToolTip="设置" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE70E;" FontSize="12"
                                    Click="Collapse_Click" ToolTip="收起" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="14,0,14,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="122" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ListBox x:Name="Nav" Style="{StaticResource NavList}" SelectionChanged="Nav_SelectionChanged">
                            <ListBoxItem Style="{StaticResource NavItem}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" Style="{StaticResource NavIcon}" />
                                    <TextBlock Text="正在播放" Style="{StaticResource NavLabel}" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource NavItem}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE823;" Style="{StaticResource NavIcon}" />
                                    <TextBlock Text="计时器" Style="{StaticResource NavLabel}" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource NavItem}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE787;" Style="{StaticResource NavIcon}" />
                                    <TextBlock Text="日历" Style="{StaticResource NavLabel}" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource NavItem}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE770;" Style="{StaticResource NavIcon}" />
                                    <TextBlock Text="系统" Style="{StaticResource NavLabel}" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource NavItem}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8C8;" Style="{StaticResource NavIcon}" />
                                    <TextBlock Text="剪贴板" Style="{StaticResource NavLabel}" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource NavItem}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;" Style="{StaticResource NavIcon}" />
                                    <TextBlock Text="文件架" Style="{StaticResource NavLabel}" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource NavItem}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xEA8F;" Style="{StaticResource NavIcon}" />
                                    <TextBlock Grid.Column="1" Text="通知" Style="{StaticResource NavLabel}" />
                                    <Border Grid.Column="2" Background="{StaticResource AccentBrush}" CornerRadius="7"
                                            Height="14" MinWidth="14" Padding="4,0" VerticalAlignment="Center"
                                            Visibility="{Binding UnreadVisibility}">
                                        <TextBlock Text="{Binding UnreadCount}" FontSize="8.5" FontWeight="Bold"
                                                   Foreground="#0A0A0C" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource NavItem}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" Style="{StaticResource NavIcon}" />
                                    <TextBlock Text="设置" Style="{StaticResource NavLabel}" />
                                </StackPanel>
                            </ListBoxItem>
                        </ListBox>

                        <Grid x:Name="PaneHost" Grid.Column="1" Margin="14,0,0,0" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
