<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows Bluetooth layer (public WinRT / Winsock APIs): discovery, SDP, RFCOMM / GATT transport, channel supervision. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>EncoDeck.Bluetooth</RootNamespace>
      <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\EncoDeck.Core\EncoDeck.Core.csproj" />
    <ProjectReference Include="..\EncoDeck.Protocol\EncoDeck.Protocol.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="EncoDeck.Tests" />
    <InternalsVisibleTo Include="EncoDeck.Probe" />
  </ItemGroup>
</Project>
